PORT=4000
NODE_ENV=development

# Database URL:
# For local dev with SQLite: "file:./dev.db"
# For Neon / Supabase / Railway PostgreSQL:
# DATABASE_URL="postgresql://user:password@ep-sample-pool.us-east-2.aws.neon.tech/propfirm?sslmode=require"
DATABASE_URL="file:./dev.db"

JWT_SECRET="generate_a_cryptographically_secure_random_64_char_string"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"
WEBHOOK_SECRET="generate_a_secure_hmac_webhook_secret_here"
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"

# Cloudflare R2 Storage (S3-compatible)
CLOUDFLARE_R2_ACCOUNT_ID="your_account_id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="propfirm-proofs"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxxxxx.r2.dev"

# Resend Email Integration
RESEND_API_KEY="re_123456789"
EMAIL_FROM="PropFirm Rewards <support@propfirmrewards.com>"

# Monitoring
SENTRY_DSN=""
